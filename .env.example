# Anthropic API key for Claude (required) — server-only, never commit real values
ANTHROPIC_API_KEY=your_api_key_here

# Access password for the UI + API session gate (required in production)
APP_ACCESS_PASSWORD=change-me

# Secret used to sign httpOnly session cookies (required in production).
# Use a long random string, different from the access password.
AUTH_SECRET=generate-a-long-random-string

# Optional: override the model used for theme extraction.
# Defaults to claude-sonnet-5 (fast + good enough for this extraction task).
# ANALYSIS_MODEL=claude-sonnet-5

# Optional: override the model used for the Ask the analyst chat.
# Falls back to ANALYSIS_MODEL, then claude-sonnet-5.
# CHAT_MODEL=claude-sonnet-5
